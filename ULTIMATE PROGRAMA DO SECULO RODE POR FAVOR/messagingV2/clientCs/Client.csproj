<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MessagingClient</RootNamespace>
    <AssemblyName>Client</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- NetMQ: implementacao ZeroMQ 100% em C# (equivalente ao pyzmq) -->
    <PackageReference Include="NetMQ" Version="4.0.1.13" />
    <!-- Protobuf: mesmo messaging.proto usado pelo servidor Python -->
    <PackageReference Include="Google.Protobuf" Version="3.25.3" />
    <PackageReference Include="Grpc.Tools" Version="2.62.0" PrivateAssets="All" />
    <Protobuf Include="messaging.proto" GrpcServices="None" />
  </ItemGroup>

</Project>
